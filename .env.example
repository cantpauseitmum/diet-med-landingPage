# ==========================================================
# Konfiguracja zmiennych środowiskowych Diet-Med Landing Page
# ==========================================================

# Porty wystawione na hoście (domyślnie przesunięte względem diet-med-app, aby uniknąć kolizji)
LANDING_DB_PORT=5433
LANDING_BACKEND_PORT=8001
LANDING_FRONTEND_PORT=3001

# Baza danych PostgreSQL dla Waitlisty i Konsultacji
POSTGRES_DB=diet_med_landing
POSTGRES_USER=landing_user
POSTGRES_PASSWORD=landing_password_secure
